# YOLO x FluxQ Environment Configuration
ENVIRONMENT=production
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration (SQLite default for local/demo, PostgreSQL for production)
DATABASE_URL=sqlite:///./yolo_fluxq.db
# DATABASE_URL=postgresql://fluxq_user:fluxq_secure_pass@postgres:5432/yolo_fluxq

# Model Artifacts Directory
MODEL_DIR=./backend/models

# Optimization Engine Parameters
DEFAULT_MAX_BUDGET_INR=15000.0
CARRIER_CAPACITY_LIMIT=50

# Quantum Simulation Parameters
ENABLE_QUANTUM_SIMULATOR=true
QAOA_MAX_QUBITS=8
